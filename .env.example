# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that should receive website queries
RESEND_CONTACT_TO=

# Must use a sender/domain verified in Resend
RESEND_FROM_EMAIL="Pure Petals <example@example.com>"

# Optional: keeps newsletter signups inside a specific Resend segment
RESEND_NEWSLETTER_SEGMENT_ID=
